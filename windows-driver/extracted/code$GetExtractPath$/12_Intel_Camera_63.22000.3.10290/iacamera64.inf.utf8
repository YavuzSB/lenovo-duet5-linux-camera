[Version]
signature="$CHICAGO$"
Class=Camera
ClassGUID={ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider=%PROVIDER_NAME%
DriverVer = 12/22/2022,63.22000.3.10290
Catalogfile=iacamera64.cat

[SourceDisksNames]
1000=%cdname%,,,

[SourceDisksFiles]
iacamera64.sys=1000
cpd_component_signed.bin=1000
cpd_component_signed_adln.bin=1000
cpd_component_signed_rpl.bin=1000
IntelDeviceMFT64.dll=1000
evcp.dll=1000
subway_user_framing.dll=1000
subway_blazeface_tracking.dll=1000
subway_centernet_tracking.dll=1000
pvl64.dll=1000
pvl_perspective_control64.dll=1000
pvl_skin_smoothing64.dll=1000
mute.bmp=1000
mute-mirror.bmp=1000
libia_cp64.dll=1000
burstisp_ipux.dll = 1000
TPG1_INTEL.cpf=1000
TPG1_INTEL.aiqb=1000
TPG2_INTEL.cpf=1000
TPG2_INTEL.aiqb=1000
TPG2_INTEL_rgbir.cpf=1000
TPG1_INTEL_SVE.cpf=1000
graph_descriptor.xml = 1000
graph_settings_TPG1_INTEL_DEFAULT.xml = 1000
graph_settings_TPG2_INTEL_DEFAULT.xml = 1000
tnr7_cm.dll=1000

[DestinationDirs]
DefaultDestDir=12
iacamera.CopyFiles=12
iacamera.CopyX64DLLs=11

[Manufacturer]
%COMPANY_NAME%=Device, NTamd64


[Device.NTamd64]
%iacamera.DeviceDesc_ADL%       =iacamera, VIDEO\INT3480

[iacamera.NT]
Include=ks.inf, KSCAPTUR.inf
Needs=KS.Registration,KSCAPTUR.Registration.NT
CopyFiles=iacamera.CopyFiles
CopyFiles=iacamera.CopyX64DLLs
AddReg=iacamera.MFT.AddReg

[iacamera.MFT.AddReg]
HKCR,CLSID\%IHV_DEVICE_PLUGIN%,,,%iacamera.FriendlyNameDeviceMFT%
HKCR,CLSID\%IHV_DEVICE_PLUGIN%\InprocServer32,,%REG_EXPAND_SZ%, "%%SystemRoot%%\System32\IntelDeviceMFT64.dll"
HKCR,CLSID\%IHV_DEVICE_PLUGIN%\InprocServer32,"ThreadingModel", %REG_SZ%, "Both"

[iacamera.CopyFiles]
iacamera64.sys
mute.bmp
mute-mirror.bmp
TPG1_INTEL.cpf
TPG1_INTEL.aiqb
TPG2_INTEL.cpf
TPG2_INTEL.aiqb
TPG2_INTEL_rgbir.cpf
TPG1_INTEL_SVE.cpf
graph_descriptor.xml
graph_settings_TPG1_INTEL_DEFAULT.xml
graph_settings_TPG2_INTEL_DEFAULT.xml
cpd_component_signed.bin
cpd_component_signed_adln.bin
cpd_component_signed_rpl.bin

[iacamera.CopyX64DLLs]
IntelDeviceMFT64.dll
evcp.dll
subway_user_framing.dll
subway_blazeface_tracking.dll
subway_centernet_tracking.dll
pvl64.dll
pvl_perspective_control64.dll
pvl_skin_smoothing64.dll
libia_cp64.dll
burstisp_ipux.dll
TPG1_INTEL.cpf
TPG1_INTEL.aiqb
TPG2_INTEL.cpf
TPG2_INTEL.aiqb
TPG2_INTEL_rgbir.cpf
TPG1_INTEL_SVE.cpf
tnr7_cm.dll

